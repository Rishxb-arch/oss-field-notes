+++ b/src/byteask_embedded_mcp/config.py
@@ -21,8 +21,21 @@ def _env(name: str, default: str) -> str:
 
 
 def _project_root() -> Path:
-    # src/byteask_embedded_mcp/config.py -> project root is three parents up.
-    return Path(__file__).resolve().parents[2]
+    """Where `.env` and relative log paths resolve.
+
+    In a source checkout (src/byteask_embedded_mcp/config.py) that is the repo
+    root, three parents up. In an installed package (pip / uvx / Smithery) that
+    path would be ``<venv>/lib/pythonX.Y`` -- so .env next to the user's project
+    was ignored and logs landed inside the virtualenv. Fall back to the current
+    working directory there. ``BYTEASK_ROOT`` overrides both.
+    """
+    override = os.getenv("BYTEASK_ROOT", "").strip()
+    if override:
+        return Path(override).expanduser().resolve()
+    here = Path(__file__).resolve()
+    if here.parent.parent.name == "src" and (here.parents[2] / "pyproject.toml").exists():
+        return here.parents[2]
+    return Path.cwd()
 
 
