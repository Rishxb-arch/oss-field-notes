diff --git a/tests/test_fixes.py b/tests/test_fixes.py
new file mode 100644
index 0000000..204302e
--- /dev/null
+++ b/tests/test_fixes.py
@@ -0,0 +1,44 @@
+import asyncio, json
+from pathlib import Path
+
+from byteask_embedded_mcp import config as cfg, server
+from byteask_embedded_mcp.http_auth import BearerTokenMiddleware
+
+
+def test_search_docs_writes_query_log(tmp_path, monkeypatch):
+    monkeypatch.setenv("BYTEASK_LOGS", str(tmp_path))
+    monkeypatch.setattr(server, "_query_log", None)
+    server.search_docs("modbus function code 16")
+    server.get_context("sample:modbus-fc16")
+    recs = [json.loads(l) for l in (tmp_path / "queries.jsonl").read_text().splitlines()]
+    assert [r["tool"] for r in recs] == ["search_docs", "get_context"]
+    assert recs[0]["status"] == "ok" and recs[0]["result_count"] >= 1
+
+
+def test_installed_package_resolves_root_to_cwd(tmp_path, monkeypatch):
+    fake = tmp_path / "venv" / "lib" / "python3.12" / "site-packages" / "byteask_embedded_mcp" / "config.py"
+    fake.parent.mkdir(parents=True); fake.write_text("")
+    monkeypatch.setattr(cfg, "__file__", str(fake))
+    monkeypatch.chdir(tmp_path)
+    monkeypatch.delenv("BYTEASK_ROOT", raising=False)
+    assert cfg._project_root() == tmp_path
+    monkeypatch.setenv("BYTEASK_ROOT", str(tmp_path / "x"))
+    assert cfg._project_root() == (tmp_path / "x").resolve()
+
+
+def _call(mw, auth):
+    sent = []
+    async def app(scope, receive, send): sent.append(200)
+    async def send(msg):
+        if msg["type"] == "http.response.start": sent.append(msg["status"])
+    m = BearerTokenMiddleware(app, "s3cret")
+    hdrs = [(b"authorization", auth)] if auth is not None else []
+    asyncio.run(m({"type": "http", "headers": hdrs}, None, send))
+    return sent[0]
+
+
+def test_bearer_scheme_case_insensitive_and_rejects_wrong():
+    assert _call(None, b"Bearer s3cret") == 200
+    assert _call(None, b"bearer s3cret") == 200
+    assert _call(None, b"Bearer nope") == 401
+    assert _call(None, None) == 401
